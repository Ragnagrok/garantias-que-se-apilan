cabal-version:   3.0
name:            garantias
version:         0.1.0.0
synopsis:        Prueba de concepto: etiquetas de seguridad que se componen al aplanar
license:         MIT
license-file:    LICENSE
author:          Federico Sawady
build-type:      Simple

common comun
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4.18 && <5

library
  import:          comun
  hs-source-dirs:  src
  exposed-modules: Etiquetas, Capas

executable demo
  import:          comun
  hs-source-dirs:  ejemplos
  main-is:         Main.hs
  build-depends:   garantias
