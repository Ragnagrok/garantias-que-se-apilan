cabal-version:   3.0
name:            guarantees
version:         0.1.0.0
synopsis:        Proof of concept: security labels that compose when you flatten
license:         MIT
license-file:    LICENSE
author:          Federico Sawady
build-type:      Simple

common comun
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4.18 && <5

library
  import:          comun
  hs-source-dirs:  src
  exposed-modules: Labels, Layers

executable demo
  import:          comun
  hs-source-dirs:  examples
  main-is:         Main.hs
  build-depends:   guarantees
